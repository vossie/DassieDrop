# DassieDrop configuration file for the Windows portable binary (dassiedrop.exe).
#
# Copy this file to dassiedrop.env in the same folder as dassiedrop.exe.
# Uncomment and edit only the settings you want to change.
#
# Format: KEY=VALUE  (no spaces required around =)
# Comments start with #. A # inside a value is part of the value.
# Quotes are optional: HOST="0.0.0.0" and HOST=0.0.0.0 are equivalent.
#
# Environment variables set before launching dassiedrop.exe always take
# precedence over values in this file.
#
# For Ubuntu/CentOS server installs, configuration lives in
# /etc/dassiedrop/dassiedrop.env instead.

# --- Network ---
# HTTP_PORT=8000
# HOST=0.0.0.0

# --- Storage ---
# Directory where uploaded files are stored.
# Defaults to an "uploads" folder next to dassiedrop.exe.
# UPLOAD_DIR=C:\DassieDrop\uploads
# Maximum total storage in bytes. 0 = unlimited.
# MAX_TOTAL_STORAGE_BYTES=0

# --- Access Control ---
# Access is managed from the Users page.
# New installs create a default root user: admin / password.
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# LOGIN_RATE_LIMIT_MAX_REQUESTS=20
# AUTH_FAILURE_WINDOW_SECONDS=60
# AUTH_MAX_FAILURES=5
# AUTH_LOCKOUT_SECONDS=60

# --- Sessions ---
# SESSION_TTL_SECONDS=604800

# --- HTTPS ---
# Set to 1 to enable HTTPS. A self-signed certificate is generated automatically
# in a "certs" folder next to dassiedrop.exe.
# HTTPS=0
# HTTPS_PORT=8443
# Hostname for the self-signed certificate. Set to your machine's hostname or LAN IP.
# HTTPS_SELF_SIGNED_HOST=localhost

# --- Share Links ---
# Base URL prepended to share links. Useful behind a reverse proxy.
# SHARE_BASE_URL=

# --- Auto-update check ---
# UPDATE_CHECK_ENABLED=0
